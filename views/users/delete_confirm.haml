.header
  %h2=title(t("users_admin.delete_confirmation"))

%ul.breadcrumb
  %li
    %a{:href=>"/admin/users"}=t("users_admin.Users_admin")
  %li.active
    =t("users_admin.delete_confirmation")

.alert.alert-warning=t("users_admin.are_you_sure_delete")

%ul
  -@users.each do |user|
    %li=escape_html(user[:name])

- if @deletion_changed
  %p.alert.alert-warning{:role=>'alert'}=t('users_admin.deletion_changed')
- if @deletion_error
  %p.alert.alert-danger{:role=>'alert'}=@deletion_error
- if @deletion_plan.related_tables.any?
  %p=t('users_admin.related_data_description')
  %table.table.table-striped#user-related-tables
    %thead
      %tr
        %th=t('users_admin.related_table')
        %th=t('users_admin.related_count')
    %tbody
      - @deletion_plan.related_tables.each do |entry|
        %tr
          %td
            %code=escape_html(entry[:table].to_s)
          %td=entry[:count]
  - if @deletion_plan.shared_resources?
    %p.alert.alert-warning=t('users_admin.deleting_shared_resources')
- else
  %p=t('users_admin.no_related_data')

%form{:method=>"post", :action=>url("/admin/users/delete")}
  %input{:type=>:hidden, :name=>:users, :value=>@users_id.join(",")}
  %input{:type=>:hidden, :name=>:confirmation, :value=>@confirmation}
  - if @deletion_plan.related_tables.any?
    .checkbox
      %label
        %input{:type=>'checkbox', :name=>'delete_related', :value=>'1', :required=>true}
        =t('users_admin.confirm_related_deletion')
  .btn-toolbar
    .btn-group.btn-group-sm{:role=>:group}
      %button.btn.btn-danger{:type=>'submit', :name=>'action', :value=>'delete'}
        %span.glyphicon.glyphicon-trash
        =t(:Delete)
      %a.btn.btn-default{:href=>url('/admin/users')}
        %span.glyphicon.glyphicon-remove
        =t(:Cancel)

