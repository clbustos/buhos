%h3{:id=>'decision_statistics'}=t(:Decisions_statistics)

- minimum=@review.expected_reviewers_for_stage(@stage)
- resolutions_patron=@ars.resolutions_f_pattern_decision(@stage)
- strict_patterns, remaining_patterns=@ars.decisions_pattern(@stage).partition {|pattern, count| @ars.pattern_meets_strict_minimum?(pattern, minimum)}
- groups=remaining_patterns.group_by {|pattern, count| @ars.pattern_reviewer_count(pattern)}
%p=t(:Minimum_reviewers_for_stage, n:minimum)
- if strict_patterns.any?
  .decision-statistics-strict
    %h4=t(:Strict_minimum_decision_patterns)
    %p=t(:Strict_minimum_decision_patterns_description, n:minimum)
    - patterns=strict_patterns.sort_by {|pattern, count| [-@ars.pattern_reviewer_count(pattern), @ars.pattern_order(pattern)]}
    =partial(:decision_statistics_table, :locals=>{patterns:patterns, resolutions_patron:resolutions_patron})
- groups.keys.sort.reverse.each do |reviewer_count|
  - patterns=groups[reviewer_count].sort_by {|pattern, count| @ars.pattern_order(pattern)}
  .decision-statistics-group{:data=>{:reviewers=>reviewer_count}}
    %h4
      =t(:Decision_pattern_reviewers, n:reviewer_count)
      - if reviewer_count < minimum
        %span.badge.alert-danger{:role=>'alert'}
          %span.glyphicon.glyphicon-warning-sign
          =t(:Below_minimum_reviewers, n:minimum)
    =partial(:decision_statistics_table, :locals=>{patterns:patterns, resolutions_patron:resolutions_patron})
