.heading
  =t_systematic_review_title(@review[:name], "systematic_review_page.#{@stage}_administration")





=partial(:breadcrumb_review_admin,:locals=>{:name=>t(@name_stage)})

%p.info=t_desc_value(:Count_canonical_documents, @cds_id.length)

=partial(:stage_resolution_summary)

%h3=t(:Statistics_by_user)

.btn-group
  %a.btn.btn-sm.btn-default{:href=>url("/review/#{@review.id}/administration/#{@stage}/reviewer_agreement")}
    %span.glyphicon.glyphicon-stats
    =t('reviewer_agreement.title')
  %a.btn.btn-sm.btn-warning{:href=>url("/review/#{@review.id}/administration_document_reports?stage=#{@stage}")}
    %span.glyphicon.glyphicon-warning-sign
    =t('document_reports.view_reported_documents')
  %a.btn.btn-sm.btn-default{:href=>"/review/#{@review[:id]}/administration/#{@stage}/cd_assignations"}
    %span.glyphicon.glyphicon-list
    =t(:Check_CD_assignations)
  %a.btn.btn-sm.btn-default{:href=>url("/review/#{@review.id}/administration/#{@stage}/resolved_without_vote")}
    %span.glyphicon.glyphicon-check
    =t('resolved_without_vote.title')
  - if !@cd_without_allocation.empty?
    %a.btn.btn-sm.btn-warning{:href=>"/review/#{@review[:id]}/administration/#{@stage}/cd_without_allocations"}
      %span.glyphicon.glyphicon-list
      =t(:Check_CD_without_assignations)
      %span.badge=@cd_without_allocation.count

- user_decisions=@ars.user_decisions(@stage)
%table.reporte.user-decision-statistics
  %thead
    %th=t(:User)
    %th=t(:Actions)
    %th=t(:Count_canonical_documents_assigned)
    - Decision::N_EST.each do |dec,name|
      %th=t(Decision.get_name_decision(dec))
  %tbody
    - user_decisions.each do |user_id, edu|
      %tr
        %th=edu[:usuario].name
        %td
          %a.btn.btn-default.btn-sm{:href=>url("/review/#{@review.id}/#{@stage}/preview/#{user_id}"), :target=>'_blank', :rel=>'noopener noreferrer'}
            %span.glyphicon.glyphicon-eye-open
            =t('reviewer_preview.open')
        %td=edu[:adu].assignations_count
        - Decision::N_EST.each do |dec,name|
          %td=edu[:adu].total_decisions[dec].to_i

  %tfoot
    %tr
      %th=t(:Total)
      %td
      %td=user_decisions.values.sum {|edu| edu[:adu].assignations_count}
      - Decision::N_EST.each_key do |dec|
        %td=user_decisions.values.sum {|edu| edu[:adu].total_decisions[dec].to_i}

=partial(:decision_statistics)

=partial(:sr_administration_actions, :locals=>{review:@review, stage:@stage})

-if @stage.to_sym==:review_full_text
  %h3=t(:Canonical_Document_Status)
  .btn-group.btn-group-sm
    %a{:href=>url("/review/#{@review[:id]}/administration/#{@stage}/canonical_document_status"),:class=>"btn btn-default btn-sm", :role=>"button"}
      %span.glyphicon.glyphicon-list
      =t(:Canonical_Document_Status)
    - if auth_to('review_admin')
      %a{:href=>url("/review/#{@review[:id]}/files"),:class=>"btn btn-default btn-sm", :role=>"button"}
        %span.glyphicon.glyphicon-file
        =t(:File_batch_management)

  =partial(:statistics_tags, :locals=>{review:@review, stage:@stage}, cache:true)
