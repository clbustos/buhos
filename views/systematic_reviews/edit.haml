%script{:type=>'text/javascript', :src=>url('/jquery-ui/jquery-ui.min.js')}
%script{:type=>'text/javascript', :src=>url('/js/criteria_manager.js')}

%link{:href=>url('/jquery-ui/jquery-ui.css') , :media => 'screen', :rel=>'stylesheet', :type=>'text/css'}
%link{:href=>url('/jquery-ui/jquery-ui.theme.css') , :media => 'screen', :rel=>'stylesheet', :type=>'text/css'}


:javascript
  $(document).ready(function () {

    $( "#form-date-creation" ).datepicker(
      $.datepicker.regional[ "#{session['language']}" ]
    );

    $( "#form-date-creation" ).datepicker( "option", "dateFormat", "yy-mm-dd" );

    var creationDate = $("#form-date-creation").val();
    if (creationDate) {
      $("#form-date-creation").datepicker("setDate", creationDate);
    }

    var groupSelect = $("#group_id_select");
    var administratorSelect = $("#group_administrator_select");
    var existingFields = $("#existing-review-group");

    function updateGroupMode() {
      var useExisting = $("input[name='group_mode']:checked").val() !== "new";
      existingFields.toggleClass("hidden", !useExisting);
      existingFields.prop("disabled", !useExisting);
    }

    $("input[name='group_mode']").on("change", updateGroupMode);

    groupSelect.on("change", function () {
      var group = $(this).find(":selected");
      var members = group.data("members") || [];
      administratorSelect.empty();
      members.forEach(function (member) {
        var selected = member.id === group.data("administrator");
        administratorSelect.append(new Option(member.name, member.id, selected, selected));
      });
    });
  });
%h2=@title
%form{:method=>:post, :action=>url("/review/update")}
  %input{:type=>"hidden", :name=>"review_id",:value=>@review[:id]}
  %div{:class=>"form-group"}
    %label{:for=>"name"}=t(:Name)
    %input{:required=>true, :class=>"form-control",:type=>"text", :name=>"name",:value=>@review[:name]}
  %fieldset.form-group
    %legend=t(:Group)
    - if @can_create_review_group
      .radio
        %label
          %input{:type=>'radio', :name=>'group_mode', :value=>'new', :checked=>@review.new?}
          =t('systematic_review.create_group')
      .radio
        %label
          %input{:type=>'radio', :name=>'group_mode', :value=>'existing', :checked=>!@review.new?, :disabled=>@review_groups.empty?}
          =t('systematic_review.use_existing_group')
    - selected_group = @review_groups.find {|group| group.id == @review.group_id} || @review_groups.first
    - if selected_group
      %fieldset#existing-review-group{:class=>('hidden' if @review.new?), :disabled=>@review.new?}
        .form-group
          %label{:for=>'group_id_select'}=t(:Group)
          %select#group_id_select.form-control{:name=>'group_id'}
            - @review_groups.each do |group|
              - members = @review_group_members[group.id]
              %option{:value=>group.id, :selected=>group.id==selected_group.id, 'data-administrator'=>group.group_administrator, 'data-members'=>(members.map {|member| {id: member.id, name: member.name}}.to_json if members)}
                &= group.name
        - if @can_manage_groups
          - selected_members = @review_group_members.fetch(selected_group.id)
          - administrator_id = selected_members.any? {|member| member.id == @review.sr_administrator} ? @review.sr_administrator : selected_group.group_administrator
          .form-group
            %label{:for=>'group_administrator_select'}=t(:Administrator)
            %select#group_administrator_select.form-control{:name=>'sr_administrator'}
              - selected_members.each do |member|
                %option{:value=>member.id, :selected=>member.id==administrator_id}
                  &= member.name
  %div{:class=>"form-group"}
    %label=t(:Description)
    =tooltip(t("systematic_review.description_tip"))
    %textarea{:class=>"form-control",:name=>"description"}=@review[:description]
  %div{:class=>"form-group"}
    %label=t(:Date_creation)
    %input{:class=>"form-control",:type=>"text", :name=>"date_creation",:value=>@review[:date_creation],:id=>"form-date-creation"}
  %div{:class=>"form-group"}
    %label=t(:Research_questions)
    %textarea{:class=>"form-control",:name=>"research_questions", :rows=>5}=@review[:research_questions]
  %div{:class=>"form-group"}
    %label=t(:Objectives)
    %textarea{:class=>"form-control",:name=>"objectives", :rows=>5}=@review[:objectives]
  %div{:class=>"form-group"}
    %label=t(:Year_start)
    =select_year(name:'year_start', value:@review[:year_start])
  %div{:class=>"form-group"}
    %label=t(:Year_end)
    =select_year(name:'year_end', value:@review[:year_end])
  %div{:class=>"form-group"}
    %label=t(:Keywords)
    %p.instructions=t(:separe_keywords_with_semicolon)
    %input{:class=>"form-control",:type=>"text", :name=>"keywords",:value=>@review[:keywords]}
  %div{:class=>"form-group"}
    %label=t(:Criteria_inclusion)
    %div{:id=>'criteria-inclusion'}=partial("systematic_reviews/criteria", :locals=>{ sr:@review, type:'inclusion'  })
  %div{:class=>"form-group"}
    %label=t(:Criteria_exclusion)
    %div{:id=>'criteria-exclusion'}=partial("systematic_reviews/criteria", :locals=>{ sr:@review, type:'exclusion'  })



  %div
    %ul.nav.nav-tabs{:role=>'tablist'}
      %li{:role=>'presentation', :class=>'active' }
        %a{:href=>'#sr-taxonomy', "aria-controls"=>'sr-taxonomy', :role=>'tab', "data-toggle"=>'tab'}=t(:Taxonomy)
      %li{:role=>'presentation'}
        %a{:href=>'#sr-advanced', "aria-controls"=>'sr-advanced', :role=>'tab', "data-toggle"=>'tab'}=t(:Advanced)
      %li{:role=>'presentation'}
        %a{:href=>'#sr-reviewers', "aria-controls"=>'sr-reviewers', :role=>'tab', "data-toggle"=>'tab'}=t(:Expected_reviewers)
    %div{:class=>'tab-content'}
      %div{:role=>'tabpanel', :class=>'tab-pane active', :id=>'sr-taxonomy'}
        %table.reporte
          - SrTaxonomy.each do |sr_taxonomy|
            %tr
              %th=t("sr_taxonomy.#{sr_taxonomy[:name]}")
              %td
                - SrTaxonomyCategory.where(:srt_id=>sr_taxonomy[:id]).each do |srtc|
                  %p
                    %input{:class=>"form-check-input",:type=>"checkbox", :name=>"srtc[#{srtc[:id]}]", :value=>1, :checked=>@taxonomy_categories_id.include?(srtc[:id])}
                    =t("sr_taxonomy_category.#{srtc[:name]}")
      %div{:role=>'tabpanel', :class=>'tab-pane', :id=>'sr-advanced'}
        %div{:class=>'form-group'}
          %label=t(:Minimum_RTA_documents_for_reference_review)
          =tooltip(t("systematic_review.minimun_RTA_document_tip"))
          %select.form-control{:class=>"form-check-input", :name=>:n_min_rr_rtr}
            - 2.upto(20) do |i|
              %option{:value=>i, :selected=>i==@review.n_min_rr_rtr}=i
        .form-group
          %label=t(:Systematic_review_active_inactive)
          %label.radio-inline
            %input{:type=>"radio", :name=>"active", :value=>1, :checked=>@review[:active] }
            =t(:Active)
          %label.radio-inline
            %input{:type=>"radio", :name=>"active", :value=>0, :checked=>!@review[:active] }
            =t(:Inactive)
        .form-group
          %label=t(:Systematic_review_tag_visibility)
          =tooltip(t(:Systematic_review_tag_visibility_tip))
          %label.radio-inline
            %input{:type=>"radio", :name=>"show_other_users_tags", :value=>1, :checked=>@review.show_other_users_tags?}
            =t(:Show_other_users_tags)
          %label.radio-inline
            %input{:type=>"radio", :name=>"show_other_users_tags", :value=>0, :checked=>!@review.show_other_users_tags?}
            =t(:Show_only_own_tags)
        .form-group
          %label=t(:Reference_blinding)
          =tooltip(t(:Reference_blinding_tip))
          %label.radio-inline
            %input{:type=>"radio", :name=>"blind_reference_screening", :value=>1, :checked=>@review.blind_reference_screening?}
            =t(:Yes)
          %label.radio-inline
            %input{:type=>"radio", :name=>"blind_reference_screening", :value=>0, :checked=>!@review.blind_reference_screening?}
            =t(:No)

        %div{:class=>"form-group"}
          %label{:for=>"stage"}=t(:Stage)
          -get_stages_names.each do |stage_id,stage_name|
            %input{:class=>"form-check-input",:type=>"radio", :name=>"stage", :value=>stage_id, :checked=>stage_id.to_s==@review[:stage]}=t(stage_name)

        %div{:class=>"form-group"}
          %label=t(:Conflict_of_interest)
          %textarea{:class=>"form-control",:name=>"conflict_of_interest", :rows=>5}=@review[:conflict_of_interest]

      %div{:role=>'tabpanel', :class=>'tab-pane', :id=>'sr-reviewers'}
        %p.instructions=t(:Expected_reviewers_description)
        - SystematicReview::EXPECTED_REVIEWER_FIELDS.each do |field|
          .form-group
            %label{:for=>field}=t(field)
            %p.help-block=t("#{field}_description")
            %input.form-control{:type=>'number', :id=>field, :name=>field, :min=>1, :step=>1, :required=>true, :value=>(@review[field] || 2)}

  %input.form-control.btn.btn-primary{:type=>:submit, :value=>t(:Save)}
